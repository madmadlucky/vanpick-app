{
  "name": "vanpick-app",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~54.0.0",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ipa": "EXPO_NO_CAPABILITY_SYNC=1 eas build -p ios --profile production",
    "submit": "eas submit -p ios --profile production",
    "export:aab": "EXPO_NO_CAPABILITY_SYNC=1 eas build -p android --profile production"
  },
  "private": true
}
