{
  "expo": {
    "name": "VanPick",
    "slug": "vanpick-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000814"
    },
    "scheme": "vanpick",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.vanpick.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "사업자등록증과 차량 이미지를 촬영해 업로드할 때 카메라 접근이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "사업자등록증과 차량 이미지를 선택해 업로드할 때 사진 접근이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "업로드에 필요한 이미지를 사진 보관함에 저장할 때 사용됩니다.",
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "kakaolink",
          "kakaoplus",
          "kakaotalk",
          "kakaokompassauth",
          "kakaolink",
          "kakaoplus",
          "kakaotalk"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.vanpick.mobile",
      "versionCode": 7,
      "permissions": [
        "INTERNET",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d5a5f854-cfe3-41b0-9292-2b52daec05b1"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
